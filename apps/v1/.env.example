# ==============================================================================
# FIREFLY V1 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development or set in Vercel project settings
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE (POSTGRESQL & AUTH)
# Required for live database persistence and multi-tenant authentication.
# In absence of Supabase keys, Firefly automatically runs in verified memory-store mode.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (RAZORPAY)
# Required for live India-focused payment processing.
# Set PAYMENT_PROVIDER="MOCK" or leave keys unset to run with the cryptographic Mock Provider.
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER="MOCK" # Set to "RAZORPAY" for production
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# CRYPTOGRAPHIC SECURITY
# 256-bit secret key used to HMAC-sign and verify QR ticket tokens
# ------------------------------------------------------------------------------
FIREFLY_TICKET_SECRET="firefly-production-cryptographic-ticket-secret-2026"

