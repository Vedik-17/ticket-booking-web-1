{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@firefly/shared-types": ["../../packages/shared-types/src"],
      "@firefly/core": ["../../packages/core/src"],
      "@firefly/design-system": ["../../packages/design-system/src"],
      "@firefly/ticket-engine": ["../../packages/ticket-engine/src"],
      "@firefly/scanner-engine": ["../../packages/scanner-engine/src"],
      "@firefly/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

